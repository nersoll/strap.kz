---
import Layout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import { portfolioData } from '@config/belt-info';
import Contact from "@components/Contact/Contact.astro";

const leathers = [...new Set(portfolioData.map((i) => i.leatherType))];
const colors = [...new Set(portfolioData.map((i) => i.color))];
---

<Layout title="Портфолио мастера" description="Все ремешки произведенные кожевной мастерской Strap.kz">
  <section class="max-w-7xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-serif mb-8 mt-15 text-center">Архив работ</h1>

    <div class="flex flex-wrap gap-4 p-6 rounded-2xl">
      <select id="filter-leather" class="py-2 rounded-lg border-gray-200 text-sm outline-none focus:ring-2 focus:ring-amber-600">
        <option value="all">Любая кожа</option>
        {leathers.map(l => <option value={l}>{l}</option>)}
      </select>

      <select id="filter-color" class="py-2 rounded-lg border-gray-200 text-sm outline-none focus:ring-2 focus:ring-amber-600">
        <option value="all">Любой цвет</option>
        {colors.map(c => <option value={c}>{c}</option>)}
      </select>
    </div>

    <!-- Основная сетка -->
    <div id="portfolio-grid">
          {portfolioData.map((item) => (
            <div 
              class="strap-card group cursor-pointer" 
              data-leather={item.leatherType} 
              data-color={item.color}
              data-item-id={item.id}
            >
              <div class="relative flex flex-col h-full overflow-hidden rounded-2xl bg-white border border-stone-200 transition-all duration-500 hover:shadow-2xl hover:border-amber-700/30">
                <div class="aspect-[3/2] overflow-hidden bg-stone-100">
                  <Image 
                    src={item.images && item.images.length > 0 ? item.images[0] : '/images/default-placeholder.jpg'} 
                    width={600} 
                    alt={`${item.leatherType} ${item.color}`}
                    class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                  />
                </div>
                <div class="flex flex-col p-6 bg-white">
                  <h3 class="text-lg font-serif font-medium text-stone-900">{item.leatherType}</h3>
                  <p class="text-sm text-stone-500">{item.color}</p>
                </div>
              </div>
            </div>
          ))}
        </div>

<div id="hidden-modals-data" class="hidden">
      {portfolioData.map((item) => (
        <div id={`modal-data-${item.id}`}>
          <div class="hidden-modal-content-images h-full flex">
            {item.images && item.images.length > 0 ? (
              item.images.map(img => (
                <div class="min-w-full h-full flex items-center justify-center overflow-hidden flex-shrink-0">
                  <Image src={img} width={800} height={800} alt="Детальное фото" class="w-full h-full object-contain block" />
                </div>
              ))
            ) : (
              <div class="min-w-full h-full flex items-center justify-center overflow-hidden flex-shrink-0">
                <Image src="/images/default-placeholder.jpg" width={800} height={800} alt="Нет фото" class="w-full h-full object-contain block" />
              </div>
            )}
          </div>
          <div class="data-text" data-leather={item.leatherType} data-color={item.color} data-fold={item.hasEdgeFold ? "С загибом (Rembordé)" : "Открытый край"}></div>
        </div>
      ))}
    </div>
    
    <!-- СКРЫТЫЙ КОНТЕЙНЕР (Данные для модалки) -->
    {portfolioData.map((item) => (
      <div id={`modal-data-${item.id}`} class="hidden">
        <div class="hidden-modal-content-images">
          {item.images.map(img => (
            <div class="min-w-full h-full flex items-center justify-center bg-gray-100 overflow-hidden">
              <Image src={img} width={800} height={800} alt="Детальное фото" class="max-w-full max-h-full object-contain" />
            </div>
          ))}
        </div>
        <div class="data-text" data-leather={item.leatherType} data-color={item.color} data-fold={item.hasEdgeFold ? "С загибом (Rembordé)" : "Открытый край"}></div>
      </div>
    ))}

    <div class="mt-16 flex justify-center">
      <button id="load-more" class="px-8 py-3 border-2 border-gray-900 font-medium hover:bg-gray-900 hover:text-white transition-all rounded-full">
        Еще работы
      </button>
    </div>
  </section>

  <!-- Модальное окно -->
  <div id="modal" class="fixed inset-0 z-[100] flex items-center justify-center p-4 bg-black/80 opacity-0 pointer-events-none transition-opacity duration-300">
      <div id="modal-overlay" class="absolute inset-0"></div>
      
      <div class="bg-white rounded-3xl max-w-5xl w-full h-[80vh] md:h-[70vh] max-h-[600px] overflow-hidden flex flex-col md:flex-row relative z-[101]">
        <button id="close-modal" class="absolute top-4 right-4 z-[102] p-2 bg-black/20 hover:bg-black/40 text-white rounded-full transition-colors w-10 h-10 flex items-center justify-center">
          ✕
        </button>
        
        <div class="relative w-full md:w-2/3 h-1/2 md:h-full bg-stone-100 flex-shrink-0 overflow-hidden">
          <div id="modal-carousel-track" class="h-full flex transition-transform duration-500">
            </div>
          
          <button id="prev-img" class="absolute left-4 top-1/2 -translate-y-1/2 bg-white/70 hover:bg-white transition-colors p-2 rounded-full z-[102] w-10 h-10 flex items-center justify-center shadow-md">
            ←
          </button>

          <button id="next-img" class="absolute right-4 top-1/2 -translate-y-1/2 bg-white/70 hover:bg-white transition-colors p-2 rounded-full z-[102] w-10 h-10 flex items-center justify-center shadow-md">
            →
          </button>
        </div>

        <div class="w-full md:w-1/3 h-1/2 md:h-full p-8 flex flex-col justify-center bg-white border-t md:border-t-0 md:border-l border-stone-100">
          <h2 id="modal-title" class="text-2xl font-serif mb-6 text-stone-900"></h2>
          <div class="space-y-4 border-t border-stone-100 pt-6">
            <div><p class="text-xs uppercase tracking-wider text-stone-400">Материал</p><p id="modal-leather" class="font-medium text-stone-800"></p></div>
            <div><p class="text-xs uppercase tracking-wider text-stone-400">Оттенок</p><p id="modal-color" class="font-medium text-stone-800"></p></div>
            <div><p class="text-xs uppercase tracking-wider text-stone-400">Тип края</p><p id="modal-fold" class="font-medium text-stone-800"></p></div>
          </div>
        </div>
      </div>
  </div>
  <Contact/>
</Layout>


<script>
  function init() {
    let visibleCount = 12;
    const BATCH_SIZE = 12;
    const grid = document.getElementById('portfolio-grid');
    const cards = Array.from(document.querySelectorAll('.strap-card')) as HTMLElement[];
    const modal = document.getElementById('modal') as HTMLElement;
    const modalTrack = document.getElementById('modal-carousel-track') as HTMLElement;
    let currentCarouselIndex = 0;

    if (!grid) return;

    // --- ФИЛЬТРАЦИЯ ---
    function updateGallery() {
      const leather = (document.getElementById('filter-leather') as HTMLSelectElement).value;
      const color = (document.getElementById('filter-color') as HTMLSelectElement).value;
      
      let shown = 0;
      cards.forEach(card => {
        const matchLeather = leather === 'all' || card.dataset.leather === leather;
        const matchColor = color === 'all' || card.dataset.color === color;
        
        if (matchLeather && matchColor) {
          shown++;
          card.style.display = shown <= visibleCount ? 'block' : 'none';
        } else {
          card.style.display = 'none';
        }
      });

      const loadMore = document.getElementById('load-more');
      if (loadMore) loadMore.style.display = shown > visibleCount ? 'inline-block' : 'none';
    }

    // --- ОТКРЫТИЕ МОДАЛКИ (Делегирование) ---
    grid.addEventListener('click', (e) => {
      const card = (e.target as HTMLElement).closest('.strap-card');
      if (card) {
        const id = (card as HTMLElement).dataset.itemId;
        const sourceData = document.getElementById(`modal-data-${id}`);
        if (!sourceData) return;

        modalTrack.innerHTML = sourceData.querySelector('.hidden-modal-content-images')!.innerHTML;
        const info = sourceData.querySelector('.data-text')!;
        
        document.getElementById('modal-title')!.textContent = `${info.getAttribute('data-leather')} ${info.getAttribute('data-color')}`;
        document.getElementById('modal-leather')!.textContent = info.getAttribute('data-leather');
        document.getElementById('modal-color')!.textContent = info.getAttribute('data-color');
        document.getElementById('modal-fold')!.textContent = info.getAttribute('data-fold');

        currentCarouselIndex = 0;
        modalTrack.style.transform = `translateX(0)`;
        modal.classList.remove('hidden', 'opacity-0');
        modal.classList.add('opacity-100');
        modal.style.pointerEvents = 'auto';
        // В самом конце блока открытия модалки (внутри условия if (card)):
        const totalImages = modalTrack.children.length;
        const prevBtn = document.getElementById('prev-img');
        const nextBtn = document.getElementById('next-img');

        if (totalImages <= 1) {
          if (prevBtn) prevBtn.style.display = 'none';
          if (nextBtn) nextBtn.style.display = 'none';
        } else {
          if (prevBtn) prevBtn.style.display = 'flex';
          if (nextBtn) nextBtn.style.display = 'flex';
        }
      }
    });

    // --- ОБРАБОТЧИКИ ---
    document.getElementById('load-more')?.addEventListener('click', () => {
      visibleCount += BATCH_SIZE;
      updateGallery();
    });

    [document.getElementById('filter-leather'), document.getElementById('filter-color')].forEach(el => 
      el?.addEventListener('change', () => { visibleCount = BATCH_SIZE; updateGallery(); })
    );

    // Закрытие
    const closeModal = () => {
      modal.classList.add('opacity-0');
      setTimeout(() => { modal.classList.add('hidden'); modal.style.pointerEvents = 'none'; }, 300);
    };
    document.getElementById('close-modal')?.addEventListener('click', closeModal);
    document.getElementById('modal-overlay')?.addEventListener('click', closeModal);

    // Карусель
    document.getElementById('next-img')?.addEventListener('click', () => {
      const total = modalTrack.children.length;
      if (total <= 1) return;
      currentCarouselIndex = (currentCarouselIndex + 1) % total;
      modalTrack.style.transform = `translateX(-${currentCarouselIndex * 100}%)`;
    });

    document.getElementById('prev-img')?.addEventListener('click', () => {
      const total = modalTrack.children.length;
      if (total <= 1) return;
      currentCarouselIndex = (currentCarouselIndex - 1 + total) % total;
      modalTrack.style.transform = `translateX(-${currentCarouselIndex * 100}%)`;
    });

    updateGallery();
  }

  // Запуск
  document.addEventListener('DOMContentLoaded', init);
  document.addEventListener('astro:page-load', init);
</script>

<style>
  #portfolio-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1.5rem; }
  .strap-card { animation: fadeIn 0.4s ease forwards; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(15px); } to { opacity: 1; transform: translateY(0); } }

  /* .strap-card:nth-child(n + 13) {
    display: none;
  } */

  /* Фикс прыгающих карточек */
  .strap-card { 
    display: flex; 
    flex-direction: column; 
    height: 100%; 
  }

  .strap-card img {
    display: block; /* Убирает лишние отступы под картинкой */
    width: 100%;
    height: 100%;
    object-fit: cover; /* Гарантирует заполнение всей площади */
  }

  /* Чтобы контейнер сразу имел правильный размер */
  .aspect-[3/2] {
    position: relative;
    width: 100%;
    display: block;
  }


  #portfolio-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1.5rem; }
  .strap-card { animation: fadeIn 0.4s ease forwards; display: flex; flex-direction: column; height: 100%; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(15px); } to { opacity: 1; transform: translateY(0); } }

  .strap-card img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .aspect-[7/5] { position: relative; width: 100%; display: block; }

  /* ЖЕСТКИЙ ФИКС ДЛЯ СЛАЙДОВ КАРУСЕЛИ */
  #modal-carousel-track {
    display: flex;
    height: 100%;
    width: 100%;
    align-items: center;
    will-change: transform;
  }

  /* Находим каждый прямой дочерний блок внутри трека (наши слайды) */
  #modal-carousel-track > div {
    width: 100% !important;
    min-width: 100% !important;
    height: 100% !important;
    flex-shrink: 0 !important; /* Насильно запрещаем слайдам сужаться */
  }

  #modal-carousel-track img {
    width: 100%;
    height: 100%;
    object-contain: fit;
  }

</style>