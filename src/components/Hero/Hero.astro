---
/**
 * * Hero with background image
 * You'll want a mobile image, and a desktop image for this.
 */

import Button from "@components/Button/Button.astro";
import heroImage from "@images/hero2.jpg";
import heroImageMobile from "@images/hero2.jpg";
import { Image } from "astro:assets";
---

<section id="hero" class="relative z-10 flex min-h-[100lvh] w-full">
	<!-- background image -->
	<div class="absolute -z-10 h-full min-h-full w-full overflow-hidden">
		<div class="absolute inset-0 bg-black/10"></div>

		<Image
			src={heroImage}
			class="hidden h-auto min-h-full w-full object-cover object-bottom sm:block"
			alt="wedding"
			aria-hidden="true"
			loading="eager"
			height={1400}
		/>
		<Image
			src={heroImageMobile}
			class="h-auto min-h-full w-full object-cover sm:hidden"
			alt="wedding"
			aria-hidden="true"
			loading="eager"
			width={1200}
		/>
	</div>

	<!-- hero items -->
	<div class="site-container relative w-full gap-10 py-50 text-center md:py-[52[] md:text-left">
		<!-- Hero text -->
		<div class="text-base-50 my-auto mr-auto max-w-[800px] flex-col">
			<h1
				class="font-heading-1 text-4xl font-semibold text-pretty drop-shadow-[0_2px_2px_rgba(230,210,181,0.8)] md:text-7xl md:leading-tight"
			>
				Мастерская ремешков
			</h1>
			<p
				class="mt-1 text-lg tracking-widest text-pretty drop-shadow-[0_1px_1px_rgba(200,170,141,0.6)] md:max-w-[550px] md:text-2xl"
			>
				Изготовление в ручную премиальных кожанных ремешков для часов
			</p>
			<div class="mt-6 flex flex-wrap justify-center gap-4 md:justify-start">
				<Button
					variant="secondary"
					arrow="right"
					href="/#contact"
					class="pl-10 text-xl text-white md:text-3xl"
				>
					Закажите сейчас
				</Button>
			</div>
		</div>
	</div>
</section>
